// LiteLaunch compatibility helpers. Unicode strings use UTF-16; indexes are 1-based.
function LLGetStringTypeW(Kind:DWORD;Src:PWideChar;Count:Integer;Types:PWord):LongBool;stdcall;external 'kernel32.dll' name 'GetStringTypeW';
function WLength(const S:WideString):Integer;begin Result:=Length(S);end;
function WCopy(const S:WideString;Index,Count:Integer):WideString;begin Result:=Copy(S,Index,Count);end;
function WCopyRight(const S:WideString;Index,Count:Integer):WideString;begin Result:=Copy(S,Max(1,Length(S)-Index-Count+2),Min(Count,Length(S)-Index+1));end;
procedure WInsert(const S:WideString;var Dest:WideString;Index:Integer);begin Insert(S,Dest,Index);end;
procedure WDeletePart(var S:WideString;Index,Count:Integer);begin Delete(S,Index,Count);end;
procedure WDeleteRight(var S:WideString;Index,Count:Integer);begin Delete(S,Max(1,Length(S)-Index-Count+2),Min(Count,Length(S)-Index+1));end;
procedure WSetLength(var S:WideString;N:Integer);begin SetLength(S,N);end;
function WPos(const A,B:WideString):Integer;begin Result:=Pos(A,B);end;
function WPosEx(const A,B:WideString;Offset:Cardinal):Integer;var N:Integer;begin N:=Pos(A,Copy(B,Offset,MaxInt));if N=0 then Result:=0 else Result:=N+Offset-1;end;
function WTextPos(const A,B:WideString):Integer;begin Result:=Pos(WideLowerCase(A),WideLowerCase(B));end;
function WTextPosEx(const A,B:WideString;Offset:Cardinal):Integer;begin Result:=WPosEx(WideLowerCase(A),WideLowerCase(B),Offset);end;
function WCompare(const A,B:WideString):Integer;begin if A<B then Result:=-1 else if A>B then Result:=1 else Result:=0;end;
function WCompareText(const A,B:WideString):Integer;begin Result:=WCompare(WideLowerCase(A),WideLowerCase(B));end;
function WSameText(const A,B:WideString):Boolean;begin Result:=WCompareText(A,B)=0;end;
function WTrimSide(const S,Chars:WideString;Side:Integer):WideString;begin Result:=S;if Side<>2 then while (Length(Result)>0) and (Pos(Result[1],Chars)>0) do Delete(Result,1,1);if Side<>1 then while (Length(Result)>0) and (Pos(Result[Length(Result)],Chars)>0) do Delete(Result,Length(Result),1);end;
function WTrimChars(const S,C:WideString):WideString;begin Result:=WTrimSide(S,C,0);end;
function WTrimLeft(const S,C:WideString):WideString;begin Result:=WTrimSide(S,C,1);end;
function WTrimRight(const S,C:WideString):WideString;begin Result:=WTrimSide(S,C,2);end;
function WReverse(const S:WideString):WideString;var I:Integer;begin Result:='';I:=Length(S);while I>0 do begin if (I>1) and (Ord(S[I])>=$DC00) and (Ord(S[I])<=$DFFF) and (Ord(S[I-1])>=$D800) and (Ord(S[I-1])<=$DBFF) then begin Result:=Result+S[I-1]+S[I];Dec(I,2);end else begin Result:=Result+S[I];Dec(I);end;end;end;
function WRepeat(const S:WideString;N:Integer):WideString;var I:Integer;begin if (N<0) or (Int64(N)*Length(S)>4194304) then raise Exception.Create('Repeated text exceeds limit');Result:='';for I:=1 to N do Result:=Result+S;end;
function WReplaceText(const S,F,R:WideString):WideString;var I,Start:Integer;Lower,Find:WideString;begin if F='' then Exit(S);Result:='';Start:=1;Lower:=WideLowerCase(S);Find:=WideLowerCase(F);repeat I:=WPosEx(Find,Lower,Start);if I=0 then Break;Result:=Result+Copy(S,Start,I-Start)+R;Start:=I+Length(F);until False;Result:=Result+Copy(S,Start,MaxInt);end;
function WCharFlags(C:WideChar):Word;begin Result:=0;LLGetStringTypeW(CT_CTYPE1,@C,1,@Result);end;
function WIsUpper(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and C1_UPPER)<>0;end;
function WIsLower(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and C1_LOWER)<>0;end;
function WIsDigit(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and C1_DIGIT)<>0;end;
function WIsSpace(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and C1_SPACE)<>0;end;
function WIsPunct(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and C1_PUNCT)<>0;end;
function WIsCntrl(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and C1_CNTRL)<>0;end;
function WIsBlank(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and C1_BLANK)<>0;end;
function WIsXDigit(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and C1_XDIGIT)<>0;end;
function WIsAlpha(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and C1_ALPHA)<>0;end;
function WIsAlphaNum(C:WideChar):Boolean;begin Result:=(WCharFlags(C) and (C1_ALPHA or C1_DIGIT))<>0;end;
function WCharUpper(C:WideChar):WideChar;begin Result:=WideUpperCase(C)[1];end;
function WCharLower(C:WideChar):WideChar;begin Result:=WideLowerCase(C)[1];end;
function WChr(Code:Word):WideChar;begin Result:=WideChar(Code);end;
function WSentence(const S:WideString):WideString;var I:Integer;begin Result:=WideLowerCase(S);for I:=1 to Length(Result) do if WIsAlpha(Result[I]) then begin Result[I]:=WCharUpper(Result[I]);Break;end;end;
function WCapitalize(const S:WideString):WideString;var I:Integer;Previous:Boolean;begin Result:=WideLowerCase(S);Previous:=False;for I:=1 to Length(Result) do begin if WIsAlpha(Result[I]) and not Previous then Result[I]:=WCharUpper(Result[I]);Previous:=WIsAlphaNum(Result[I]);end;end;
function WInvert(const S:WideString):WideString;var I:Integer;begin Result:=S;for I:=1 to Length(Result) do if WIsUpper(Result[I]) then Result[I]:=WCharLower(Result[I]) else Result[I]:=WCharUpper(Result[I]);end;
function WBool(B:Boolean):WideString;begin if B then Result:='True' else Result:='False';end;
function WInt64(N:Int64):WideString;begin Result:=IntToStr(N);end;
function WFloat(N:Double):WideString;begin Result:=FloatToStr(N);end;
function WStrFloat(const S:WideString):Double;begin Result:=StrToFloat(S);end;
function WFloatFormat(const F:WideString;N:Double):WideString;begin Result:=FormatFloat(F,N);end;
function WIncYear(D:TDateTime;N:Integer):TDateTime;begin Result:=IncYear(D,N);end;
function WIncMonth(D:TDateTime;N:Integer):TDateTime;begin Result:=IncMonth(D,N);end;
function WIncWeek(D:TDateTime;N:Integer):TDateTime;begin Result:=IncWeek(D,N);end;
function WIncDay(D:TDateTime;N:Integer):TDateTime;begin Result:=IncDay(D,N);end;
function WIncHour(D:TDateTime;N:Int64):TDateTime;begin Result:=IncHour(D,N);end;
function WIncMinute(D:TDateTime;N:Int64):TDateTime;begin Result:=IncMinute(D,N);end;
function WIncSecond(D:TDateTime;N:Int64):TDateTime;begin Result:=IncSecond(D,N);end;
function WIncMilli(D:TDateTime;N:Int64):TDateTime;begin Result:=IncMilliSecond(D,N);end;
function WScanDate(const F,S:WideString):TDateTime;begin Result:=ScanDateTime(F,S);end;
function WSecondSpan(A,B:TDateTime):Double;begin Result:=Abs(A-B)*86400;end;

procedure RegisterCompatibility(Sender:TPSScript);
begin
 Sender.AddFunction(@WLength,'function WideLength(const S: WideString): Integer;');
 Sender.AddFunction(@WCopy,'function WideCopy(const S: WideString; Index, Count: Integer): WideString;');
 Sender.AddFunction(@WCopyRight,'function WideCopyRight(const S: WideString; Index, Count: Integer): WideString;');
 Sender.AddFunction(@WInsert,'procedure WideInsert(const S: WideString; var Dest: WideString; Index: Integer);');
 Sender.AddFunction(@WDeletePart,'procedure WideDelete(var S: WideString; Index, Count: Integer);');
 Sender.AddFunction(@WDeleteRight,'procedure WideDeleteRight(var S: WideString; Index, Count: Integer);');
 Sender.AddFunction(@WSetLength,'procedure WideSetLength(var S: WideString; N: Integer);');
 Sender.AddFunction(@WPos,'function WidePos(const A, B: WideString): Integer;');
 Sender.AddFunction(@WPosEx,'function WidePosEx(const A, B: WideString; Offset: Cardinal): Integer;');
 Sender.AddFunction(@WTextPos,'function WideTextPos(const A, B: WideString): Integer;');
 Sender.AddFunction(@WTextPosEx,'function WideTextPosEx(const A, B: WideString; Offset: Cardinal): Integer;');
 Sender.AddFunction(@WCompare,'function WideCompareStr(const A, B: WideString): Integer;');
 Sender.AddFunction(@WCompareText,'function WideCompareText(const A, B: WideString): Integer;');
 Sender.AddFunction(@WSameText,'function WideSameText(const A, B: WideString): Boolean;');
 Sender.AddFunction(@WTrim,'function WideTrim(const S: WideString): WideString;');
 Sender.AddFunction(@WTrimChars,'function WideTrimChars(const S, C: WideString): WideString;');
 Sender.AddFunction(@WTrimLeft,'function WideTrimCharsLeft(const S, C: WideString): WideString;');
 Sender.AddFunction(@WTrimRight,'function WideTrimCharsRight(const S, C: WideString): WideString;');
 Sender.AddFunction(@WReverse,'function WideReverseString(const S: WideString): WideString;');
 Sender.AddFunction(@WRepeat,'function WideRepeatString(const S: WideString; N: Integer): WideString;');
 Sender.AddFunction(@WReplaceText,'function WideReplaceText(const S, F, R: WideString): WideString;');
 Sender.AddFunction(@WSentence,'function WideCaseSentence(const S: WideString): WideString;');
 Sender.AddFunction(@WCapitalize,'function WideCaseCapitalize(const S: WideString): WideString;');
 Sender.AddFunction(@WInvert,'function WideCaseInvert(const S: WideString): WideString;');
 Sender.AddFunction(@WIsUpper,'function IsWideCharUpper(C: WideChar): Boolean;');
 Sender.AddFunction(@WIsLower,'function IsWideCharLower(C: WideChar): Boolean;');
 Sender.AddFunction(@WIsDigit,'function IsWideCharDigit(C: WideChar): Boolean;');
 Sender.AddFunction(@WIsSpace,'function IsWideCharSpace(C: WideChar): Boolean;');
 Sender.AddFunction(@WIsPunct,'function IsWideCharPunct(C: WideChar): Boolean;');
 Sender.AddFunction(@WIsCntrl,'function IsWideCharCntrl(C: WideChar): Boolean;');
 Sender.AddFunction(@WIsBlank,'function IsWideCharBlank(C: WideChar): Boolean;');
 Sender.AddFunction(@WIsXDigit,'function IsWideCharXDigit(C: WideChar): Boolean;');
 Sender.AddFunction(@WIsAlpha,'function IsWideCharAlpha(C: WideChar): Boolean;');
 Sender.AddFunction(@WIsAlphaNum,'function IsWideCharAlphaNumeric(C: WideChar): Boolean;');
 Sender.AddFunction(@WCharUpper,'function WideCharUpper(C: WideChar): WideChar;');
 Sender.AddFunction(@WCharLower,'function WideCharLower(C: WideChar): WideChar;');
 Sender.AddFunction(@WChr,'function WideChr(Code: Word): WideChar;');
 Sender.AddFunction(@WBool,'function BoolToStr(B: Boolean): WideString;');
 Sender.AddFunction(@WFloatFormat,'function FormatFloat(const F: WideString; N: Double): WideString;');
 Sender.AddFunction(@WIncYear,'function IncYear(D: TDateTime; N: Integer): TDateTime;');
 Sender.AddFunction(@WIncMonth,'function IncMonth(D: TDateTime; N: Integer): TDateTime;');
 Sender.AddFunction(@WIncWeek,'function IncWeek(D: TDateTime; N: Integer): TDateTime;');
 Sender.AddFunction(@WIncDay,'function IncDay(D: TDateTime; N: Integer): TDateTime;');
 Sender.AddFunction(@WIncHour,'function IncHour(D: TDateTime; N: Int64): TDateTime;');
 Sender.AddFunction(@WIncMinute,'function IncMinute(D: TDateTime; N: Int64): TDateTime;');
 Sender.AddFunction(@WIncSecond,'function IncSecond(D: TDateTime; N: Int64): TDateTime;');
 Sender.AddFunction(@WIncMilli,'function IncMilliSecond(D: TDateTime; N: Int64): TDateTime;');
 Sender.AddFunction(@WScanDate,'function ScanDateTime(const F, S: WideString): TDateTime;');
 Sender.AddFunction(@WSecondSpan,'function SecondSpan(A, B: TDateTime): Double;');
end;
